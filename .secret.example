# Template for local secrets. Copy to ".secret" and fill in real values:
#     cp .secret.example .secret
# The real ".secret" file is gitignored and read at build time (build.rs).

# --- Wi-Fi ---
WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password

# --- DB API Marketplace: Timetables API ---
# Create an app at https://developers.deutschebahn.com and subscribe to
# "Timetables". Client Id + Client Secret (a.k.a. API key) come from there.
DB_CLIENT_ID=your-client-id
DB_API_KEY=your-client-secret
# EVA number of the station (Erlangen-Bruck = 8001845).
DB_EVA_NO=8001845

# --- Google Calendar (OAuth, installed-app / desktop flow) ---
# 1. https://console.cloud.google.com -> create a project.
# 2. "APIs & Services" -> enable the "Google Calendar API".
# 3. "APIs & Services" -> "Credentials" -> "Create credentials" ->
#    "OAuth client ID" -> application type "Desktop app".
#    Copy the Client ID + Client Secret below.
# 4. Run a one-time consent on your PC to mint a refresh token with scope
#    https://www.googleapis.com/auth/calendar.readonly (offline access).
#    Paste the resulting refresh token below.
# Leave GCAL_REFRESH_TOKEN empty to disable the calendar block.
GCAL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GCAL_CLIENT_SECRET=your-oauth-client-secret
GCAL_REFRESH_TOKEN=your-refresh-token
# Calendar id to show; empty defaults to "primary".
GCAL_CALENDAR_ID=
